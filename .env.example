# Sources officielles supplémentaires. Copier les variables utiles dans .env.
# Ne jamais publier une clé réelle dans ce fichier.
# Les administrateurs peuvent aussi renseigner les accès dans Interconnexions API.
# Clé de chiffrement des accès saisis : sauvegarder ce fichier avec la base.
# Son emplacement doit rester privé et persistant (hors static/uploads).
API_CREDENTIALS_KEY_PATH=/data/api_credentials.key
# Météo-France : créer un compte et souscrire aux API Observations et Radar.
METEO_FRANCE_API_KEY=
# Utiliser ces surcharges si les abonnements ont deux clés différentes.
METEO_FRANCE_OBSERVATIONS_API_KEY=
METEO_FRANCE_RADAR_API_KEY=
# Facultatif : jeton Bearer temporaire ; préférer les clés d'application ci-dessus.
METEO_FRANCE_ACCESS_TOKEN=
# Vide = sélection automatique des stations d'Isère ; 40 maximum par collecte.
METEO_FRANCE_STATION_IDS=
METEO_FRANCE_STATION_LIMIT=40
# INSEE : import automatique en arrière-plan. Optionnel : archive déjà présente
# dans le conteneur, par exemple /data/static/Filosofi2021_carreaux_200m_csv.zip.
INSEE_POPULATION_LOCAL_PATH=
